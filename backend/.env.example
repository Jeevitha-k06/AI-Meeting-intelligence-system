# Copy to backend/.env and fill in values from Supabase Dashboard → Settings → API

SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your-service-role-or-anon-key

# Create a row in public.teams, then paste its id here (required for uploads)
DEFAULT_TEAM_ID=your-team-uuid-here

# Optional
CORS_ORIGINS=*
DEBUG=true
APP_TITLE=SyncSpace AI API
