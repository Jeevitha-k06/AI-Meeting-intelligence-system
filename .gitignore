# ─── Python / Backend ─────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.so
*.egg
*.egg-info/
dist/
build/
.eggs/
.mypy_cache/
.ruff_cache/
.pytest_cache/
.coverage
htmlcov/

# Virtual environment
.venv/
venv/
env/
ENV/

# ─── Environment / Secrets ────────────────────────────────────────────────────
# Never commit real secrets
backend/.env
frontend/.env

# Keep the example files
!backend/.env.example

# ─── ML Workspace ─────────────────────────────────────────────────────────────
ml_workspace/__pycache__/
ml_workspace/output/
# NLTK data downloaded at runtime
nltk_data/

# HuggingFace / SentenceTransformers model cache
.cache/
~/.cache/huggingface/

# ─── Frontend / Node ──────────────────────────────────────────────────────────
frontend/node_modules/
frontend/dist/
frontend/.vite/
frontend/coverage/

# ─── Uploads (runtime files, not source) ──────────────────────────────────────
backend/uploads/*
!backend/uploads/.gitkeep

# ─── Editor / OS ──────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
desktop.ini

# ─── Logs ─────────────────────────────────────────────────────────────────────
*.log
logs/
